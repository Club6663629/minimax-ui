# 生产环境配置模板：复制为 server/.env 并修改
# cp deploy/.env.example server/.env

# 必改：JWT 签名密钥
JWT_SECRET=change-me-to-a-long-random-string

# 数据存储目录（上传/中间产物/成片/SQLite）
DATA_DIR=/data/minimax-ui
DATABASE_URL=sqlite:////data/minimax-ui/app.db

# ComfyUI（多卡集群，见《H3集群部署方案-机房9卡版》）
# 格式：条目间分号分隔，每项 url|角色|标签（标签内逗号分隔）
#   角色：generate（768p 生成）/ upscale（SeedVR2 超分）
#   标签：heavy（长片段优先）/ 1k / 2k / overflow（仅主力全忙时承接 1K）
#         unet:<权重文件名>：派发时注入的权重（7B FP16 / 3B INT8 / 7B INT8 / GGUF）
#         engine:seedvr2：7B FP16 原生节点模板 / engine:seedvr2_int8：3B INT8 模板（默认）
# 9 卡拓扑：生成 4（A100/4090/2×4090） + 超分主力 3（7B FP16） + 1K 溢出/轻量 2（3B INT8）
COMFYUI_WORKERS="\
http://192.168.10.45:8188|generate|heavy,director;\
http://192.168.10.51:8188|generate|;\
http://192.168.10.246:8188|generate|;\
http://192.168.10.246:8189|generate|;\
http://192.168.10.45:8189|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.10.45:8190|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.5.205:8188|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.10.45:8191|upscale|1k,overflow;\
http://192.168.10.246:8190|upscale|1k,overflow,unet:seedvr2_3b_int8_convrot.safetensors"
# 单实例/无 ComfyUI 联调：留空 COMFYUI_WORKERS 退回 COMFYUI_URL 串行；模拟模式：
COMFYUI_URL=http://127.0.0.1:8188
# MOCK_COMFY=1

# 集群开关（可选，均为默认值）
# UPSCALE_ENABLED=true          # 本地超分池开关（关闭后 1K/2K 档不可提交）
# DEGRADE_QUEUE_DEPTH=8         # 生成队列深度超阈值且有云端 Key → 云端全流程降级
# CLOUD_UPSCALE_FALLBACK=true   # 本地超分重试耗尽后，2K 回落云端重生成

# 长视频导演台（TimelineDirector）：超过单块时长按段拆分生成再 ffmpeg 拼接
# DIRECTOR_ENABLED=true
# DIRECTOR_CHUNK_SECONDS=30       # 导演台单块生成时长上限（秒）；超过按段边界拆分生成再 ffmpeg 拼接

# 云端 API（可选）：配置后启用 提示词增强 + 云端降级/2K 回落；不配置则纯本地出片
# MINIMAX_API_KEY=your-api-key
# MINIMAX_API_BASE=https://api.minimax.io

# 剧集工坊（studio）：剧本 + 美术设定 → 80 集地图 → 设定图 → 切表 → 成片
# 不开则导航里的「剧集工坊」直接提示未开启（接口返 400），不影响其它功能
# STUDIO_ENABLED=1
# STUDIO_DIR=/opt/minimax-ui/data/studio   # 留空 = <DATA_DIR>/studio
# STUDIO_NODE_BIN=node                     # 跑 shuohao 门的 node 路径
# STUDIO_GATE_TIMEOUT=60
# 设定图节点：留空则沿用 ADVIDEO_IMAGE_WORKER（qwen-image-2.1 该台机器）
# STUDIO_IMAGE_WORKER=http://<qwen21-node>:8188
# STUDIO_IMAGE_TIMEOUT_MINUTES=20
# STUDIO_COST_IMAGE=0                      # 0 = 沿用 COST_AD_IMAGE

# 计费（积分），按需调整
SIGNUP_BONUS=50
COST_768P_5S=10
COST_768P_10S=20
COST_1K_EXTRA=8
COST_2K_EXTRA=15

# 初始管理员（首次启动自动创建，可选）
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin-password
