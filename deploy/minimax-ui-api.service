[Unit]
Description=MiniMax H3 Studio API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=comfy
WorkingDirectory=/opt/minimax-ui/server
# 环境变量（JWT_SECRET / MINIMAX_API_KEY / DATA_DIR 等）写在 .env
EnvironmentFile=/opt/minimax-ui/server/.env
ExecStart=/opt/minimax-ui/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
