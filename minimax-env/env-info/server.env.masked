# MiniMax H3 Studio 生产配置（P0 控制面重建）
JWT_SECRET=<MASKED>

# 数据存储（TiDB 持久化）
DATA_DIR=/data/minimax-ui
DATABASE_URL=<MASKED>

# ComfyUI Worker 池（P0：仅本机 A100 生成节点；超分节点 P1/P2 再加）
