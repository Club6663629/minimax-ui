# server/.env 脱敏副本（2026-09-17）
# 真实文件：/data/workspace/minimax-ui/server/.env（已被 .gitignore 排除，不入 patch）
# 脱敏规则：JWT_SECRET / DB 密码 / MINIMAX_API_KEY 全部替换为 <REDACTED>，其余原样
# 需要真值时请在服务器 45 上直接读取该文件。

JWT_SECRET=<REDACTED>

# 数据存储（TiDB 持久化）
DATA_DIR=/data/minimax-ui
DATABASE_URL=mysql+pymysql://minimax:<REDACTED>@172.17.0.2:4000/minimax?charset=utf8mb4

# ComfyUI Worker 池
# --- 2026-09-14 按用户指示暂时摘除 A100 生成节点 http://192.168.10.45:8188 ---
# --- 恢复方法：删掉下面这行 COMFYUI_WORKERS 并把 ORIG 那行改名(去掉 # 与 _ORIG_withA100) ---
#COMFYUI_WORKERS_ORIG_withA100="http://192.168.10.45:8188|generate|...,http://192.168.10.51:8188|generate|...,http://192.168.10.246:8188|generate|...,http://192.168.5.205:8188|upscale|...,http://127.0.0.1:8183|generate|..."
COMFYUI_WORKERS="http://192.168.10.51:8188|generate|unet:fl2va:minimax_h3_fl2va_pruned_int8_convrot.safetensors,unet:ref2va:minimax_h3_ref2va_pruned_int8_convrot.safetensors;http://192.168.10.246:8188|generate|unet:fl2va:minimax_h3_fl2va_pruned_int8_convrot.safetensors,unet:ref2va:minimax_h3_ref2va_pruned_int8_convrot.safetensors;http://192.168.5.205:8188|upscale|1k,2k,4k,engine:rtx,unet:seedvr2_7b_int8_convrot.safetensors;http://127.0.0.1:8183|generate|unet:fl2va:MiniMax_H3_FL2VA_pruned_int8_convrot.safetensors,unet:ref2va:MiniMax_H3_ref2va_pruned_int8_convrot.safetensors"
COMFYUI_URL=http://127.0.0.1:8188

# 集群开关
UPSCALE_ENABLED=true
DEGRADE_QUEUE_DEPTH=8
CLOUD_UPSCALE_FALLBACK=true

# 计费
SIGNUP_BONUS=50
COST_768P_5S=10
COST_768P_10S=20
COST_1K_EXTRA=8
COST_2K_EXTRA=15
COST_4K_EXTRA=30

# MiniMax 云端 API（H3-Context-IR 编译层 / 2K 重生成 / 云端降级）
MINIMAX_API_KEY=<REDACTED>
MINIMAX_API_BASE=https://api.minimax.cn
