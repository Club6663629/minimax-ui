COMFYUI_URL=http://127.0.0.1:8188

# 集群开关
UPSCALE_ENABLED=true
# 长视频导演台（TimelineDirector）后端入口；默认关，拍板后置 true
DIRECTOR_ENABLED=true
DEGRADE_QUEUE_DEPTH=8
CLOUD_UPSCALE_FALLBACK=true

# 计费
SIGNUP_BONUS=50
COST_768P_5S=10
COST_768P_10S=20
COST_1K_EXTRA=8
COST_2K_EXTRA=15
COST_4K_EXTRA=30

# MiniMax 云端 API（H3-Context-IR 编译层 / 2K 重生成 / 云端降级）
MINIMAX_API_KEY=<MASKED>
MINIMAX_API_BASE=https://api.minimax.cn
