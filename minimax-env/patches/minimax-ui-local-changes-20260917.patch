new file mode 100644
index 0000000..355068b
--- /dev/null
+++ b/server/clouds/example.env
@@ -0,0 +1,15 @@
+# 云端实例配置模板（占位符，可提交 git）
+# 用法：复制成 <platform>-<uuid>.env 并填写真实值，chmod 600（真实文件不入库）
+CLOUD_ID=autodl:pro-xxxxxxxxxxxx
+CLOUD_DISPLAY_NAME=AutoDL-5090(bj-B2)
+CLOUD_PLATFORM=autodl
+CLOUD_INSTANCE_UUID=pro-xxxxxxxxxxxx
+# 必须与 COMFYUI_WORKERS 中该节点 url 完全一致
+CLOUD_WORKER_URL=http://127.0.0.1:8183
+CLOUD_API_BASE=https://api.autodl.com
+CLOUD_API_TOKEN=replace-with-platform-token
+# 开机后执行的命令（放云端数据盘，幂等）
+CLOUD_BOOT_COMMAND=bash /root/autodl-fs/start_comfy.sh
+CLOUD_READY_TIMEOUT=600
+CLOUD_READY_POLL=10
+CLOUD_ALLOW_POWER_OFF=true
