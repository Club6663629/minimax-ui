# 生产环境配置模板：复制为 server/.env 并修改
# cp deploy/.env.example server/.env

# 必改：JWT 签名密钥
JWT_SECRET=change-me-to-a-long-random-string

# 数据存储目录（上传/中间产物/成片/SQLite）
DATA_DIR=/data/minimax-ui
DATABASE_URL=sqlite:////data/minimax-ui/app.db

# ComfyUI（多卡集群，见《H3集群部署方案-机房9卡版》）
# 格式：条目间分号分隔，每项 url|角色|标签（标签内逗号分隔）
#   角色：generate（768p 生成）/ upscale（SeedVR2 超分）
#   标签：heavy（长片段优先）/ 1k / 2k / overflow（仅主力全忙时承接 1K）
#         unet:<权重文件名>：派发时注入的权重（7B FP16 / 3B INT8 / 7B INT8 / GGUF）
#         engine:seedvr2：7B FP16 原生节点模板 / engine:seedvr2_int8：3B INT8 模板（默认）
# 9 卡拓扑：生成 4（A100/4090/2×4090） + 超分主力 3（7B FP16） + 1K 溢出/轻量 2（3B INT8）
COMFYUI_WORKERS="\
http://192.168.10.45:8188|generate|heavy;\
http://192.168.10.51:8188|generate|;\
http://192.168.10.246:8188|generate|;\
http://192.168.10.246:8189|generate|;\
http://192.168.10.45:8189|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.10.45:8190|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.5.205:8188|upscale|1k,2k,engine:seedvr2,unet:seedvr2_ema_7b_fp16.safetensors;\
http://192.168.10.45:8191|upscale|1k,overflow;\
http://192.168.10.246:8190|upscale|1k,overflow,unet:seedvr2_3b_int8_convrot.safetensors"
# 单实例/无 ComfyUI 联调：留空 COMFYUI_WORKERS 退回 COMFYUI_URL 串行；模拟模式：
COMFYUI_URL=http://127.0.0.1:8188
# MOCK_COMFY=1

# 集群开关（可选，均为默认值）
# UPSCALE_ENABLED=true          # 本地超分池开关（关闭后 1K/2K 档不可提交）
# DEGRADE_QUEUE_DEPTH=8         # 生成队列深度超阈值且有云端 Key → 云端全流程降级
# CLOUD_UPSCALE_FALLBACK=true   # 本地超分重试耗尽后，2K 回落云端重生成

# 云端 API（可选）：配置后启用 提示词增强 + 云端降级/2K 回落；不配置则纯本地出片
# MINIMAX_API_KEY=your-api-key
# MINIMAX_API_BASE=https://api.minimax.io

# 计费（积分），按需调整
SIGNUP_BONUS=50
COST_768P_5S=10
COST_768P_10S=20
COST_1K_EXTRA=8
COST_2K_EXTRA=15

# 初始管理员（首次启动自动创建，可选）
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin-password

# ---------------------------------------------------------------- 短剧工作台 HiBTV
# 文本 7 阶段（outline/characters/art/refs/script/staging/storyboard）归 codex 网关，像素归平台。
# 网关只绑 127.0.0.1:8910，公网 /v1/* 与 /healthz 已 404 → **平台后端必须与网关同机**；
# 不同机请先开隧道：ssh -L 8910:127.0.0.1:8910 <gw-host>
HIBTV_ENABLED=true

CODEX_GW_ENABLED=true
CODEX_GW_URL=http://127.0.0.1:8910
# 网关 token：默认从 token.txt（0600）读，只存文件路径，**绝不入库、绝不下发前端**
# 也可直接给值（不建议：进程环境对 root 可见）
# CODEX_GW_TOKEN=xxx
CODEX_GW_TOKEN_FILE=/data/workspace/codex-gateway/token.txt
CODEX_GW_TIMEOUT=30                 # 单次 HTTP 超时秒
CODEX_GW_JOB_TIMEOUT=1800           # 单个 job 总时长上限（含 3 次重试的 stage 会到 ~350s）
CODEX_GW_SILENCE_TIMEOUT=600        # 静默超时：无心跳即视为假死
CODEX_GW_DEFAULT_EFFORT=medium      # low | medium | high
CODEX_GW_POLL_INTERVAL=5
CODEX_GW_POLL_GRACE=120             # 平台轮询上限 = job timeout + 该值，超时先 cancel 再置 failed
CODEX_GW_PROJECT_PREFIX=hibtv-      # 网关侧 /data/projects/<prefix><id>/

# 资产单图：一资产一张（提示词照抄 skill 的 image.prompt，不追加平台自造约束）
# 语言：en = image.prompt（默认） / zh = image.promptLocal
HIBTV_IMAGE_PROMPT_LANG=en
HIBTV_ASSET_SIZE_CAST=896x1152
HIBTV_ASSET_SIZE_SCENE=1280x720
HIBTV_ASSET_SIZE_PROP=1024x1024

# 关键帧画布（9:16 原生网格；16:9 用 1344x768）
HIBTV_IMAGE_WIDTH=768
HIBTV_IMAGE_HEIGHT=1344
# 段长上限：H3 只出 5+17n 帧（24fps），13s → 请求 311 帧 = 12.9583s（传 13 会被吸附到 13.67s）
HIBTV_SEG_MAX_SECONDS=13
