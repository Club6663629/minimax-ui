+    if asset is None or not (asset.main_path or "").strip():
+        return None
+    path = abs_path(project.id, asset.main_path)
+    if not path.exists():
+        return None
+    return {"kind": asset.kind, "code": asset.code, "name": asset.name, "path": path}
